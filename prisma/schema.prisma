generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String        @id @default(uuid())
  email                 String        @unique
  password              String
  name                  String
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  active                Boolean       @default(true)
  createdBy             String?
  role                  UserRole      @default(REGISTRATION_STAFF)
  permissions           Json?
  requirePasswordChange Boolean       @default(true)
  activityLogs          ActivityLog[]
  reviewedPurchases     MockExamPurchase[] @relation("PurchaseReviewer")
  author                Author?
  agentId               String?
  travelAgent           TravelAgent?  @relation(fields: [agentId], references: [id])
  isAgentOwner          Boolean       @default(false)
}

model Location {
  id                     String        @id @default(uuid())
  name                   String        @unique
  nameEn                 String?
  nameAr                 String?
  code                   String?
  isActive               Boolean       @default(true)
  address                String?
  locationUrl            String?
  applicants             Applicant[]
  examCenters            ExamCenter[]
  transactions           Transaction[]
  vouchers               Voucher[]
}

model ServiceConfig {
  id                         String   @id @default("global")
  registrationPrice          Decimal  @default(0) @db.Decimal(10, 2)
  examChangeFee              Decimal  @default(16000) @db.Decimal(10, 2)
  maxFreeChanges             Int      @default(1)
  updatedAt                  DateTime @updatedAt
  examChangeCost             Decimal  @default(0) @db.Decimal(10, 2)
  registrationCost           Decimal  @default(0) @db.Decimal(10, 2)
  examCancellationDeadline   Int      @default(72)
  examModificationDeadline   Int      @default(72)
  maxAllowedExamChanges      Int      @default(1)
  enableMockExamNewQuestions Boolean  @default(false)
  mockExamPackagesEnabled    Boolean  @default(true)
  mockExamSinglePrice        Decimal  @default(0) @db.Decimal(10, 2)
  agentMockExamSinglePrice   Decimal  @default(0) @db.Decimal(10, 2) // سعر الاختبار المفرد الأساسي للوكلاء
}

model MockExamPackage {
  id                       String             @id @default(uuid())
  name                     String
  nameEn                   String?
  description              String?
  badge                    String?
  color                    String?
  icon                     String?
  examCredits              Int
  includesRegistration     Boolean            @default(false)
  includesTransport        Boolean            @default(false)
  transportType            String?
  features                 Json?              @default("[]")
  price                    Decimal            @default(0) @db.Decimal(10, 2)
  actualCost               Decimal            @default(0) @db.Decimal(10, 2)
  validityDays             Int?
  isActive                 Boolean            @default(true)
  isFeatured               Boolean            @default(false)
  sortOrder                Int                @default(0)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  examPrice                Decimal            @default(0) @db.Decimal(10, 2)
  registrationDiscount     Decimal            @default(0) @db.Decimal(10, 2)
  transportDiscount        Decimal            @default(0) @db.Decimal(10, 2)
  isFree                   Boolean            @default(false)
  priceSAR                 Decimal            @default(0) @db.Decimal(10, 2)
  showResultCorrectAnswers Boolean            @default(true)
  showResultQuestions      Boolean            @default(true)
  showResultScore          Boolean            @default(true)
  firstAttemptFullFeatures Boolean            @default(false)
  allowedQuestionTypes     String             @default("MCQ,TRUE_FALSE,FILL_BLANK,IMAGE")
  attemptsConfig           Json?              @default("[]")
  examQuestionsCount       Int?
  agentPrice               Decimal            @default(0) @db.Decimal(10, 2) // السعر الأساسي للوكلاء
  purchases                MockExamPurchase[]
  agentConfigs             AgentPackageConfig[]
}

model MockExamPurchase {
  id              String           @id @default(uuid())
  phone           String
  buyerName       String?
  email           String?
  applicantId     String?
  packageId       String?
  totalCredits    Int
  usedCredits     Int              @default(0)
  amount          Decimal          @db.Decimal(10, 2)
  currency        String           @default("YER")
  isPaid          Boolean          @default(false)
  paymentMethod   String?
  paymentNote     String?
  status          String           @default("PENDING")
  transactionRef  String?          @unique
  proofAttachment String?
  rejectedReason  String?
  reviewedById    String?
  reviewedBy      User?            @relation("PurchaseReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  activatedAt     DateTime?
  expiresAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  profession      String?
  sessions        ExamSession[]
  package         MockExamPackage? @relation(fields: [packageId], references: [id])
  smsTransactions SmsTransaction[]
}

model TransportDestination {
  id                 String                  @id @default(uuid())
  name               String                  @unique
  nameEn             String?
  nameAr             String?
  code               String?
  isActive           Boolean                 @default(true)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  tripsFrom          ScheduledTrip[]         @relation("TripFrom")
  tripsTo            ScheduledTrip[]         @relation("TripTo")
  stops              ScheduledTripStop[]
  routeDefaultsFrom  TransportRouteDefault[] @relation("RouteDefaultFrom")
  routeDefaultsTo    TransportRouteDefault[] @relation("RouteDefaultTo")
  TransportRouteStop TransportRouteStop[]
  applicants         Applicant[]             @relation("TransportFrom")
}

model ScheduledTrip {
  id                String               @id @default(uuid())
  tripNumber        String               @unique
  fromDestinationId String
  toDestinationId   String
  date              DateTime             @db.Date
  departureTime     String
  arrivalTime       String?
  price             Decimal              @db.Decimal(10, 2)
  capacity          Int                  @default(50)
  bookedSeats       Int                  @default(0)
  busNumber         String?
  driverName        String?
  status            TripStatus           @default(SCHEDULED)
  notes             String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  arrivalDate       DateTime?            @db.Date
  busClass          PricingBusClass?
  customizedAt      DateTime?
  driverId          String?
  groupId           String?
  groupRole         TripGroupRole?
  isCustomized      Boolean              @default(false)
  routeId           String?
  templateId        String?
  vehicleId         String?
  driver            Driver?              @relation(fields: [driverId], references: [id])
  fromDestination   TransportDestination @relation("TripFrom", fields: [fromDestinationId], references: [id])
  group             TripGroup?           @relation(fields: [groupId], references: [id])
  route             TransportRoute?      @relation(fields: [routeId], references: [id])
  template          TripTemplate?        @relation(fields: [templateId], references: [id])
  toDestination     TransportDestination @relation("TripTo", fields: [toDestinationId], references: [id])
  vehicle           Vehicle?             @relation(fields: [vehicleId], references: [id])
  stops             ScheduledTripStop[]
  returnTickets     Ticket[]             @relation("ReturnTrip")
  tickets           Ticket[]
}

model ScheduledTripStop {
  id            String               @id @default(uuid())
  tripId        String
  destinationId String
  arrivalTime   String?
  departureTime String?
  price         Decimal              @db.Decimal(10, 2)
  orderIndex    Int
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  departureDate DateTime?            @db.Date
  routeStopId   String?
  boardingPoint String?
  destination   TransportDestination @relation(fields: [destinationId], references: [id])
  routeStop     TransportRouteStop?  @relation(fields: [routeStopId], references: [id])
  trip          ScheduledTrip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model TransportPricingRule {
  id                     String                @id @default(uuid())
  name                   String
  isActive               Boolean               @default(true)
  priority               Int                   @default(0)
  routeFromId            String?
  routeToId              String?
  passengerType          PricingPassengerType?
  tripType               PricingTripType?
  busClass               PricingBusClass?
  seasonStartDate        DateTime?
  seasonEndDate          DateTime?
  minAdvanceBookingHours Int?
  actionType             PricingActionType
  amount                 Decimal               @db.Decimal(10, 2)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
}

model CancellationPolicy {
  id           String   @id @default(uuid())
  name         String
  feeAmount    Decimal  @db.Decimal(10, 2)
  isActive     Boolean  @default(true)
  category     String
  condition    String?
  createdAt    DateTime @default(now())
  hoursTrigger Int?
  updatedAt    DateTime @updatedAt
}

model Applicant {
  id                String          @id @default(uuid())
  fullName          String
  profession        String
  phone             String
  whatsappNumber    String
  examDate          DateTime?
  examTime          String?
  platformEmail     String?         @unique
  platformPassword  String?
  notificationEmail String?
  examTicketImage   String?
  certificateImage  String?
  status            ApplicantStatus @default(NEW_REGISTRATION)
  notes             String?
  hasTransportation Boolean         @default(false)
  travelDate        DateTime?
  totalAmount       Decimal         @db.Decimal(10, 2)
  amountPaid        Decimal         @default(0) @db.Decimal(10, 2)
  remainingBalance  Decimal         @db.Decimal(10, 2)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  discount          Decimal         @default(0) @db.Decimal(10, 2)
  isArchived        Boolean         @default(false)
  applicantType     String?         @default("RESIDENT")
  dob               DateTime?
  firstName         String?
  gender            String?
  lastName          String?
  nationalId        String?
  passportExpiry    DateTime?
  passportNumber    String?
  applicantCode     String?         @unique
  locationId        String?
  transportType     String?
  transportFromId   String?
  examLocation      String?
  examCenterId      String?
  activityLogs      ActivityLog[]
  examCenter        ExamCenter?     @relation(fields: [examCenterId], references: [id])
  location          Location?       @relation(fields: [locationId], references: [id])
  transportFrom     TransportDestination? @relation("TransportFrom", fields: [transportFromId], references: [id])
  documents         Document[]
  examSessions      ExamSession[]
  messageLogs       MessageLog[]
  ticket            Ticket?
  transactions      Transaction[]
  vouchers          Voucher[]
}

model ExamCenter {
  id          String      @id @default(uuid())
  name        String
  address     String?
  locationUrl String?
  isActive    Boolean     @default(true)
  locationId  String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  applicants  Applicant[]
  location    Location    @relation(fields: [locationId], references: [id])
}

model MessageLog {
  id          String    @id @default(uuid())
  applicantId String
  templateId  String?
  trigger     String
  channel     String    @default("WHATSAPP")
  message     String
  attachments String?
  status      String    @default("SENT")
  sentAt      DateTime  @default(now())
  createdAt   DateTime  @default(now())
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
}

model PricingPackage {
  id         String        @id @default(uuid())
  name       String        @unique
  location   ExamLocation?
  price      Decimal       @db.Decimal(10, 2)
  actualCost Decimal       @db.Decimal(10, 2)
  active     Boolean       @default(true)
}

model Transaction {
  id              String          @id @default(uuid())
  applicantId     String?
  amount          Decimal         @db.Decimal(10, 2)
  type            TransactionType
  date            DateTime        @default(now())
  notes           String?
  category        String?
  description     String?
  relatedLocation ExamLocation?
  locationId      String?
  isPending       Boolean         @default(false)
  applicant       Applicant?      @relation(fields: [applicantId], references: [id])
  location        Location?       @relation(fields: [locationId], references: [id])
}

model ActivityLog {
  id          String     @id @default(uuid())
  action      String
  details     String?
  userId      String?
  applicantId String?
  timestamp   DateTime   @default(now())
  applicant   Applicant? @relation(fields: [applicantId], references: [id])
  user        User?      @relation(fields: [userId], references: [id])
}

model MessagingTemplate {
  id        String   @id @default(uuid())
  name      String
  type      String
  subject   String?
  body      String
  variants  Json?      // Array of alternative bodies
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  trigger   String?  @unique
}

model Document {
  id          String       @id @default(uuid())
  applicantId String
  type        DocumentType
  fileName    String
  fileUrl     String
  uploadedAt  DateTime     @default(now())
  applicant   Applicant    @relation(fields: [applicantId], references: [id], onDelete: Cascade)
}

model Ticket {
  id                String         @id @default(uuid())
  applicantId       String         @unique
  ticketNumber      String         @unique
  busNumber         String?
  seatNumber        String?
  departureDate     DateTime
  departureLocation String
  arrivalLocation   String
  transportCompany  String
  status            String         @default("ISSUED")
  createdAt         DateTime       @default(now())
  tripId            String?
  returnBusNumber   String?
  returnSeatNumber  String?
  returnTripId      String?
  agentName         String?
  boardingPoint     String?
  companions        Json?
  applicant         Applicant      @relation(fields: [applicantId], references: [id])
  returnTrip        ScheduledTrip? @relation("ReturnTrip", fields: [returnTripId], references: [id])
  trip              ScheduledTrip? @relation(fields: [tripId], references: [id])
}

model Voucher {
  id              String      @id @default(uuid())
  applicantId     String
  type            VoucherType
  notes           String?
  isUsed          Boolean     @default(false)
  usedAt          DateTime?
  createdAt       DateTime    @default(now())
  expiresAt       DateTime?
  discountPercent Float       @default(100)
  locationId      String?
  applicant       Applicant   @relation(fields: [applicantId], references: [id])
  location        Location?   @relation(fields: [locationId], references: [id])
}

model TransportRouteDefault {
  id                String               @id @default(uuid())
  fromDestinationId String
  toDestinationId   String
  price             Decimal              @db.Decimal(10, 2)
  priceRoundTrip    Decimal?             @db.Decimal(10, 2)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  cost              Decimal?             @default(0) @db.Decimal(10, 2)
  costRoundTrip     Decimal?             @default(0) @db.Decimal(10, 2)
  fromDestination   TransportDestination @relation("RouteDefaultFrom", fields: [fromDestinationId], references: [id])
  toDestination     TransportDestination @relation("RouteDefaultTo", fields: [toDestinationId], references: [id])
  currency          String               @default("YER")

  @@unique([fromDestinationId, toDestinationId])
}

model TransportRoute {
  id              String               @id @default(uuid())
  name            String               @unique
  code            String?
  isActive        Boolean              @default(true)
  returnRouteId   String?              @unique
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  trips           ScheduledTrip[]
  returnRoute     TransportRoute?      @relation("RouteReturn", fields: [returnRouteId], references: [id])
  inverseOfReturn TransportRoute?      @relation("RouteReturn")
  stops           TransportRouteStop[]
  templates       TripTemplate[]
}

model TransportRouteStop {
  id                  String               @id @default(uuid())
  routeId             String
  destinationId       String
  orderIndex          Int
  minutesFromStart    Int                  @default(0)
  stopDurationMinutes Int                  @default(0)
  priceFromStart      Decimal              @default(0) @db.Decimal(10, 2)
  allowBoarding       Boolean              @default(true)
  allowDropoff        Boolean              @default(true)
  boardingPoint       String?
  tripStops           ScheduledTripStop[]
  destination         TransportDestination @relation(fields: [destinationId], references: [id])
  route               TransportRoute       @relation(fields: [routeId], references: [id], onDelete: Cascade)
}

model TripTemplate {
  id                String          @id @default(uuid())
  name              String
  routeId           String
  departureTime     String
  busClass          PricingBusClass @default(STANDARD)
  recurrenceRule    String
  startDate         DateTime        @db.Date
  endDate           DateTime?       @db.Date
  defaultDriverName String?
  defaultBusNumber  String?
  defaultDriverId   String?
  defaultVehicleId  String?
  capacity          Int             @default(50)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  trips             ScheduledTrip[]
  defaultDriver     Driver?         @relation(fields: [defaultDriverId], references: [id])
  defaultVehicle    Vehicle?        @relation(fields: [defaultVehicleId], references: [id])
  route             TransportRoute  @relation(fields: [routeId], references: [id])
}

model TripGroup {
  id         String          @id @default(uuid())
  name       String?
  driverName String?
  busNumber  String?
  driverId   String?
  vehicleId  String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  trips      ScheduledTrip[]
  driver     Driver?         @relation(fields: [driverId], references: [id])
  vehicle    Vehicle?        @relation(fields: [vehicleId], references: [id])
}

model Driver {
  id        String          @id @default(uuid())
  name      String
  phone     String?
  licenseNo String?
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  trips     ScheduledTrip[]
  groups    TripGroup[]
  templates TripTemplate[]
}

model Vehicle {
  id          String          @id @default(uuid())
  plateNumber String          @unique
  name        String?
  capacity    Int
  busClass    PricingBusClass @default(STANDARD)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  trips       ScheduledTrip[]
  groups      TripGroup[]
  templates   TripTemplate[]
}

model Profession {
  id                   String            @id @default(uuid())
  name                 String            @unique
  slug                 String            @unique
  description          String?
  examDuration         Int               @default(60)
  questionCount        Int               @default(30)
  passingScore         Int               @default(60)
  isActive             Boolean           @default(true)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  maxAttempts          Int               @default(3)
  enabledQuestionTypes String            @default("MCQ")
  algorithmConfig      Json?
  aiJobs               AIGenerationJob[]
  examSessions         ExamSession[]
  questions            Question[]
  agentOrders          AgentExamOrder[]
}

model Question {
  id             String                @id @default(uuid())
  professionId   String
  text           String
  explanation    String?
  difficulty     QuestionDifficulty    @default(HARD)
  isActive       Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  axis           String                @default("CORE")
  cognitiveLevel String?               @default("K2")
  imageUrl       String?
  type           QuestionType          @default(MCQ)
  questionStyle  String                @default("SCENARIO")
  sessionAnswers ExamSessionQuestion[]
  profession     Profession            @relation(fields: [professionId], references: [id], onDelete: Cascade)
  options        QuestionOption[]
}

model QuestionOption {
  id             String                @id @default(uuid())
  questionId     String
  text           String
  isCorrect      Boolean               @default(false)
  sessionAnswers ExamSessionQuestion[]
  question       Question              @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model ExamSession {
  id                String                @id @default(uuid())
  token             String                @unique @default(uuid())
  type              ExamSessionType
  status            ExamSessionStatus     @default(NEW)
  professionId      String
  applicantId       String?
  visitorName       String?
  startedAt         DateTime?
  completedAt       DateTime?
  score             Decimal?              @db.Decimal(5, 2)
  passingScore      Int                   @default(60)
  isPassed          Boolean?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  visitorPhone      String?
  visitorEmail      String?
  attemptNumber     Int                   @default(1)
  deviceFingerprint String?
  ipAddress         String?
  isBanned          Boolean               @default(false)
  purchaseId        String?
  applicant         Applicant?            @relation(fields: [applicantId], references: [id])
  profession        Profession            @relation(fields: [professionId], references: [id], onDelete: Cascade)
  purchase          MockExamPurchase?     @relation(fields: [purchaseId], references: [id])
  questions         ExamSessionQuestion[]
  agentOrderId      String?               @unique
  agentOrder        AgentExamOrder?

  @@index([token])
  @@index([professionId])
  @@index([deviceFingerprint])
}

model ExamSessionQuestion {
  id               String          @id @default(uuid())
  sessionId        String
  questionId       String
  selectedOptionId String?
  isCorrect        Boolean?
  question         Question        @relation(fields: [questionId], references: [id])
  selectedOption   QuestionOption? @relation(fields: [selectedOptionId], references: [id])
  session          ExamSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
}

model AIGenerationJob {
  id                 String      @id @default(uuid())
  professionId       String
  status             AIJobStatus @default(PENDING)
  prompt             String?
  questionsRequested Int
  questionsGenerated Int         @default(0)
  errorLog           String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  profession         Profession  @relation(fields: [professionId], references: [id], onDelete: Cascade)
}

model MockVisitorOtp {
  phone         String   @id
  code          String
  expiresAt     DateTime
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now())
  dailyAttempts Int      @default(0)
  lastAttemptAt DateTime @default(now())
}

enum PricingPassengerType {
  ADULT
  CHILD
  INFANT
}

enum PricingTripType {
  ONE_WAY
  ROUND_TRIP
  MULTI_CITY
}

enum PricingBusClass {
  STANDARD
  VIP
}

enum PricingActionType {
  FIXED_PRICE
  PERCENTAGE_DISCOUNT
  PERCENTAGE_MARKUP
  FIXED_DISCOUNT
  FIXED_MARKUP
}

enum TripStatus {
  SCHEDULED
  BOARDING
  DEPARTED
  COMPLETED
  CANCELLED
  DELAYED
  DRAFT
  CONFIRMED
}

enum TripGroupRole {
  OUTBOUND
  RETURN
}

enum ExamLocation {
  TAIZ
  ADEN
  HADRAMOUT
}

enum ApplicantStatus {
  NEW_REGISTRATION
  ACCOUNT_CREATED
  EXAM_SCHEDULED
  AWAITING_EXAM
  ATTENDED_EXAM
  PASSED
  FAILED
  POSTPONED
  CANCELLED
  SERVICES_CONFIGURED
  ABSENT
}

enum UserRole {
  ADMIN
  REGISTRATION_STAFF
  ACCOUNTANT
  FOLLOW_UP_STAFF
  TRAVEL_AGENT
}

enum TransactionType {
  PAYMENT
  EXPENSE
  WITHDRAWAL
  CHARGE
}

enum DocumentType {
  EXAM_TICKET
  CERTIFICATE
  ID_DOCUMENT
  OTHER
}

enum VoucherType {
  EXAM
  TRANSPORT_ONEWAY
  TRANSPORT_ROUNDTRIP
  FULL_PROGRAM
  EXAM_RETAKE
}

enum QuestionAxis {
  HEALTH_SAFETY
  PROFESSION_KNOWLEDGE
  GENERAL_SKILLS
  OCCUPATIONAL_SAFETY
  CORRECT_METHODS
  PROFESSIONAL_BEHAVIOR
  TOOLS_AND_EQUIPMENT
  EMERGENCIES_FIRST_AID
}

enum QuestionDifficulty {
  HARD
  EXPERT
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  FILL_BLANK
}

enum ExamSessionType {
  PRIVATE
  PUBLIC
}

enum ExamSessionStatus {
  NEW
  STARTED
  SUBMITTED
  EXPIRED
  RESUMED
  TIMEOUT
}

enum AIJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model WalletAccount {
  id            String   @id @default(uuid())
  name          String
  nameEn        String?
  accountNumber String?
  accountName   String?
  isActive      Boolean  @default(true)
  icon          String?
  instructions  String?  @db.Text
  accounts      Json?    @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SmsTransaction {
  id                    String            @id @default(uuid())
  textbeeMessageId      String?           @unique
  sender                String
  body                  String            @db.Text
  amount                Decimal?          @db.Decimal(10, 2)
  transactionNumber     String?           @unique
  walletName            String?
  deviceFingerprint     String?
  isMatched             Boolean           @default(false)
  matchedPurchaseId     String?
  matchedPurchase       MockExamPurchase? @relation(fields: [matchedPurchaseId], references: [id])
  rawPayload            Json?
  receivedAt            DateTime          @default(now())
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([transactionNumber])
  @@index([sender])
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

model Article {
  id               String        @id @default(uuid())
  title            String
  slug             String        @unique
  content          String        @db.Text
  summary          String?       @db.Text
  featuredImage    String?
  status           ArticleStatus @default(DRAFT)
  readTime         Int           @default(5)
  views            Int           @default(0)
  isFeatured       Boolean       @default(false)
  actionButtonText String?
  actionButtonUrl  String?
  publishedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  authorId         String?
  author           Author?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  categoryId       String
  category         Category      @relation(fields: [categoryId], references: [id])
  tags             Tag[]

  metaTitle        String?
  metaDescription  String?       @db.Text
  metaKeywords     String?
  ogTitle          String?
  ogDescription    String?       @db.Text
  ogImage          String?
  canonicalUrl     String?

  @@index([slug])
  @@index([status])
  @@index([categoryId])
  @@index([authorId])
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  nameEn      String?
  slug        String    @unique
  description String?   @db.Text
  articles    Article[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
}

model Tag {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  articles  Article[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([slug])
}

model Author {
  id        String    @id @default(uuid())
  name      String
  title     String?
  avatar    String?
  bio       String?   @db.Text
  userId    String?   @unique
  user      User?     @relation(fields: [userId], references: [id])
  articles  Article[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model SystemCurrency {
  id         String   @id @default(uuid())
  code       String   @unique
  name       String
  buyRate    Decimal  @db.Decimal(10, 2)
  sellRate   Decimal  @db.Decimal(10, 2)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model SmtpConfig {
  id         String   @id @default(uuid())
  host       String
  port       Int
  user       String   @unique
  pass       String
  senderName String   @default("بوابة الاعتماد المهني")
  secure     Boolean  @default(true)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TravelAgent {
  id                String              @id @default(uuid())
  companyName       String              // اسم المكتب/الوكالة
  companyNameEn     String?
  ownerName         String              // اسم المالك/المسؤول
  phone             String              @unique
  whatsappNumber    String?
  email             String?             @unique
  address           String?
  city              String?
  logo              String?
  licenseNumber     String?
  commissionRate    Decimal             @default(0) @db.Decimal(5, 2) // نسبة الخصم (قديم - تم استبداله بالتسعير المخصص)
  customSingleExamPrice Decimal?        @db.Decimal(10, 2) // سعر مخصص للاختبار المفرد (null = استخدام السعر الأساسي)
  walletBalance     Decimal             @default(0) @db.Decimal(10, 2) // الرصيد المالي
  totalDeposited    Decimal             @default(0) @db.Decimal(10, 2) // إجمالي الإيداعات
  totalSpent        Decimal             @default(0) @db.Decimal(10, 2) // إجمالي المصروف
  currency          String              @default("YER")
  allowDebt         Boolean             @default(false)
  debtLimit         Decimal             @default(0) @db.Decimal(10, 2)
  status            AgentStatus         @default(ACTIVE)
  notes             String?
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  // العلاقات
  users             User[]              // عدة مستخدمين لكل وكالة
  clients           AgentClient[]
  walletTransactions AgentWalletTransaction[]
  examOrders        AgentExamOrder[]
  packageConfigs    AgentPackageConfig[]

  @@index([phone])
  @@index([status])
}

enum AgentStatus {
  ACTIVE
  SUSPENDED
  PENDING_APPROVAL
}

model AgentClient {
  id                String              @id @default(uuid())
  agentId           String
  fullName          String
  phone             String
  whatsappNumber    String?
  email             String?
  profession        String?
  nationalId        String?
  passportNumber    String?
  notes             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  agent             TravelAgent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  examOrders        AgentExamOrder[]

  @@index([agentId])
  @@index([phone])
}

model AgentExamOrder {
  id                String              @id @default(uuid())
  agentId           String
  clientId          String
  professionId      String
  sessionId         String?             @unique
  status            AgentOrderStatus    @default(PENDING)
  examLink          String?
  examPrice         Decimal             @db.Decimal(10, 2) // سعر الاختبار وقت الشراء
  sentAt            DateTime?
  completedAt       DateTime?
  score             Decimal?            @db.Decimal(5, 2)
  isPassed          Boolean?
  notificationSent  Boolean             @default(false)
  createdByUserId   String?             // المستخدم الذي أنشأ الطلب
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  agent             TravelAgent         @relation(fields: [agentId], references: [id])
  client            AgentClient         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  profession        Profession          @relation(fields: [professionId], references: [id])
  session           ExamSession?        @relation(fields: [sessionId], references: [id])

  @@index([agentId])
  @@index([clientId])
  @@index([status])
}

enum AgentOrderStatus {
  PENDING
  SENT
  STARTED
  COMPLETED
  EXPIRED
  CANCELLED
}

model AgentWalletTransaction {
  id              String                    @id @default(uuid())
  agentId         String
  type            WalletTransactionType
  amount          Decimal                   @db.Decimal(10, 2) // المبلغ
  balanceBefore   Decimal                   @db.Decimal(10, 2)
  balanceAfter    Decimal                   @db.Decimal(10, 2)
  description     String?
  orderId         String?                   // ربط بطلب الاختبار (عند الخصم)
  approvedById    String?
  createdAt       DateTime                  @default(now())

  agent           TravelAgent               @relation(fields: [agentId], references: [id])

  @@index([agentId])
  @@index([type])
}

enum WalletTransactionType {
  DEPOSIT         // إيداع/شحن رصيد
  EXAM_PURCHASE   // شراء اختبار (خصم)
  REFUND          // استرجاع
  BONUS           // مكافأة
  ADJUSTMENT      // تعديل يدوي
}

model AgentPackageConfig {
  id          String           @id @default(uuid())
  agentId     String
  packageId   String
  isEnabled   Boolean          @default(true)
  customPrice Decimal          @db.Decimal(10, 2)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  agent       TravelAgent      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  package     MockExamPackage  @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([agentId, packageId])
  @@index([agentId])
}
